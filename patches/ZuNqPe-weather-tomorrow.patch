+def select_forecast_points(points, *, tomorrow: bool):
+    """Select the 24 hourly points for today or the next calendar day."""
+    target_date = points[0].time.date()
+    if tomorrow:
+        target_date += timedelta(days=1)
+
+    return tuple(
+        point
+        for point in points
+        if point.time.date() == target_date
+    )[:24]
 
 
